{
  "name": "easypanel-oauth2-server",
  "version": "2.0.0",
  "description": "OAuth2 server that integrates with Easypanel user authentication",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && vite build",
    "start": "node dist/index.js",
    "dev": "concurrently \"cross-env PORT=3100 ts-node-dev --respawn src/index.ts\" \"wait-on tcp:3100 && vite\"",
    "lint": "eslint src/**/*.ts",
    "test": "jest",
    "start:prod": "set NODE_ENV=production&& node dist/index.js",
    "start:prod:unix": "NODE_ENV=production node dist/index.js"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.21.0",
    "@scalar/api-reference-react": "^0.9.24",
    "axios": "^1.5.0",
    "body-parser": "^1.20.2",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "jose": "^4.15.4",
    "lmdb": "^3.2.6",
    "next-themes": "^0.4.6",
    "open": "^10.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "swagger-ui-react": "^5.32.4",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.2",
    "@types/express": "^4.17.17",
    "@types/express-session": "^1.17.7",
    "@types/jest": "^29.5.3",
    "@types/node": "^20.5.7",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/swagger-ui-react": "^5.18.0",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "eslint": "^8.48.0",
    "jest": "^29.6.3",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2",
    "vite": "^5.3.4",
    "wait-on": "^9.0.5"
  }
}
