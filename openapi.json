{
  "openapi": "3.1.0",
  "info": {
    "title": "Easypanel OAuth2 Server",
    "version": "1.0.0",
    "description": "Standards-compliant OAuth2 / OpenID Connect authorization server integrated with Easypanel user management.\n\n## Authentication\nMost OAuth endpoints use client credentials (Basic auth or body params).\nThe `/oauth/userinfo` endpoint requires a Bearer access token.\nThe `/api/clients` endpoints require either an authenticated admin session or an `X-API-Key` header.\n"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "OAuth2",
      "description": "Core OAuth2 and OpenID Connect endpoints"
    },
    {
      "name": "Client Management",
      "description": "OAuth client CRUD (admin only)"
    }
  ],
  "paths": {
    "/.well-known/openid-configuration": {
      "get": {
        "tags": [
          "OAuth2"
        ],
        "summary": "OpenID Connect Discovery",
        "description": "Returns server metadata including endpoint URLs, supported scopes, and signing algorithms.",
        "operationId": "getDiscovery",
        "responses": {
          "200": {
            "description": "Discovery document",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiscoveryDocument"
                }
              }
            }
          }
        }
      }
    },
    "/oauth/jwks": {
      "get": {
        "tags": [
          "OAuth2"
        ],
        "summary": "JSON Web Key Set",
        "description": "Returns the public keys used to verify JWT signatures.",
        "operationId": "getJwks",
        "responses": {
          "200": {
            "description": "JWKS",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "keys": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Jwk"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/oauth/authorize": {
      "get": {
        "tags": [
          "OAuth2"
        ],
        "summary": "Authorization endpoint",
        "description": "Initiates the Authorization Code flow. Redirects the user to the login page if not authenticated,\nthen to the consent screen. After approval, redirects back to `redirect_uri` with a `code` parameter.\n",
        "operationId": "authorize",
        "parameters": [
          {
            "name": "response_type",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "code"
              ]
            }
          },
          {
            "name": "client_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "redirect_uri",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            }
          },
          {
            "name": "scope",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "openid profile email"
            }
          },
          {
            "name": "state",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "nonce",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to login or consent page"
          },
          "400": {
            "description": "Invalid request parameters",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/oauth/token": {
      "post": {
        "tags": [
          "OAuth2"
        ],
        "summary": "Token endpoint",
        "description": "Exchanges credentials for access tokens. Supports five grant types:\n- `authorization_code`\n- `refresh_token`\n- `urn:ietf:params:oauth:grant-type:device_code`\n- `password` (legacy)\n- `client_credentials`\n\nClient credentials can be supplied via HTTP Basic auth or as body parameters.\n",
        "operationId": "token",
        "security": [
          {
            "basicAuth": []
          },
          {}
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/TokenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/OAuthError"
          },
          "401": {
            "$ref": "#/components/responses/OAuthError"
          }
        }
      }
    },
    "/oauth/introspect": {
      "post": {
        "tags": [
          "OAuth2"
        ],
        "summary": "Token introspection (RFC 7662)",
        "description": "Validates a token and returns its metadata. Returns `{\"active\":false}` for invalid tokens.",
        "operationId": "introspect",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "token"
                ],
                "properties": {
                  "token": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Introspection response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntrospectionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/oauth/revoke": {
      "post": {
        "tags": [
          "OAuth2"
        ],
        "summary": "Token revocation (RFC 7009)",
        "description": "Invalidates an access or refresh token. Always returns 200 regardless of whether the token existed.\nClient credentials required.\n",
        "operationId": "revoke",
        "security": [
          {
            "basicAuth": []
          },
          {}
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "token"
                ],
                "properties": {
                  "token": {
                    "type": "string"
                  },
                  "token_type_hint": {
                    "type": "string",
                    "enum": [
                      "access_token",
                      "refresh_token"
                    ]
                  },
                  "client_id": {
                    "type": "string"
                  },
                  "client_secret": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token revoked (or did not exist)"
          },
          "401": {
            "$ref": "#/components/responses/OAuthError"
          }
        }
      }
    },
    "/oauth/userinfo": {
      "get": {
        "tags": [
          "OAuth2"
        ],
        "summary": "UserInfo endpoint (OIDC)",
        "description": "Returns claims about the authenticated user. Requires a valid Bearer access token.",
        "operationId": "userinfo",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "User claims",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserInfo"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/OAuthError"
          },
          "404": {
            "$ref": "#/components/responses/OAuthError"
          }
        }
      }
    },
    "/oauth/device": {
      "post": {
        "tags": [
          "OAuth2"
        ],
        "summary": "Device Authorization (RFC 8628)",
        "description": "Initiates the device authorization flow. The device should display the `user_code`\nand `verification_uri` to the user, then poll `/oauth/token` with `grant_type=urn:ietf:params:oauth:grant-type:device_code`.\n",
        "operationId": "deviceAuthorize",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "client_id"
                ],
                "properties": {
                  "client_id": {
                    "type": "string"
                  },
                  "scope": {
                    "type": "string",
                    "example": "profile email"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Device authorization response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceAuthResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/OAuthError"
          }
        }
      }
    },
    "/api/clients": {
      "get": {
        "tags": [
          "Client Management"
        ],
        "summary": "List all clients",
        "operationId": "listClients",
        "security": [
          {
            "apiKey": []
          },
          {
            "sessionAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Client list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "clients": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Client"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/ApiError"
          },
          "403": {
            "$ref": "#/components/responses/ApiError"
          }
        }
      },
      "post": {
        "tags": [
          "Client Management"
        ],
        "summary": "Create a client",
        "operationId": "createClient",
        "security": [
          {
            "apiKey": []
          },
          {
            "sessionAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClientCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Client created (includes secret — only shown once)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "client": {
                      "$ref": "#/components/schemas/ClientWithSecret"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ApiError"
          }
        }
      }
    },
    "/api/clients/{id}": {
      "get": {
        "tags": [
          "Client Management"
        ],
        "summary": "Get a client",
        "operationId": "getClient",
        "security": [
          {
            "apiKey": []
          },
          {
            "sessionAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ClientId"
          }
        ],
        "responses": {
          "200": {
            "description": "Client details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "client": {
                      "$ref": "#/components/schemas/Client"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/ApiError"
          }
        }
      },
      "put": {
        "tags": [
          "Client Management"
        ],
        "summary": "Update a client",
        "operationId": "updateClient",
        "security": [
          {
            "apiKey": []
          },
          {
            "sessionAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ClientId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClientUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated client",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "client": {
                      "$ref": "#/components/schemas/Client"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/ApiError"
          }
        }
      },
      "delete": {
        "tags": [
          "Client Management"
        ],
        "summary": "Delete a client",
        "operationId": "deleteClient",
        "security": [
          {
            "apiKey": []
          },
          {
            "sessionAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ClientId"
          }
        ],
        "responses": {
          "200": {
            "description": "Client deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/ApiError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "Client ID and secret as HTTP Basic credentials"
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Access token issued by the token endpoint"
      },
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Admin API key (CLIENT_API_KEY env var)"
      },
      "sessionAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "connect.sid",
        "description": "Session cookie from browser login"
      }
    },
    "parameters": {
      "ClientId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "OAuth client ID"
      }
    },
    "responses": {
      "OAuthError": {
        "description": "OAuth error response",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/OAuthError"
            }
          }
        }
      },
      "ApiError": {
        "description": "API error response",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      }
    },
    "schemas": {
      "TokenRequest": {
        "type": "object",
        "required": [
          "grant_type"
        ],
        "properties": {
          "grant_type": {
            "type": "string",
            "enum": [
              "authorization_code",
              "refresh_token",
              "password",
              "client_credentials",
              "urn:ietf:params:oauth:grant-type:device_code"
            ]
          },
          "code": {
            "type": "string",
            "description": "Required for authorization_code grant"
          },
          "redirect_uri": {
            "type": "string",
            "description": "Required for authorization_code grant"
          },
          "refresh_token": {
            "type": "string",
            "description": "Required for refresh_token grant"
          },
          "device_code": {
            "type": "string",
            "description": "Required for device_code grant"
          },
          "username": {
            "type": "string",
            "description": "Required for password grant"
          },
          "password": {
            "type": "string",
            "description": "Required for password grant"
          },
          "scope": {
            "type": "string"
          },
          "client_id": {
            "type": "string"
          },
          "client_secret": {
            "type": "string"
          }
        }
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string"
          },
          "token_type": {
            "type": "string",
            "example": "Bearer"
          },
          "expires_in": {
            "type": "integer",
            "example": 3600
          },
          "refresh_token": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "id_token": {
            "type": "string",
            "description": "JWT ID token (only present when openid scope is granted)"
          }
        }
      },
      "IntrospectionResponse": {
        "type": "object",
        "properties": {
          "active": {
            "type": "boolean"
          },
          "client_id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "exp": {
            "type": "integer"
          }
        }
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "sub": {
            "type": "string",
            "description": "Subject identifier (user ID)"
          },
          "email": {
            "type": "string"
          },
          "email_verified": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "DeviceAuthResponse": {
        "type": "object",
        "properties": {
          "device_code": {
            "type": "string"
          },
          "user_code": {
            "type": "string",
            "example": "BCDF-GHJK"
          },
          "verification_uri": {
            "type": "string"
          },
          "verification_uri_complete": {
            "type": "string"
          },
          "expires_in": {
            "type": "integer",
            "example": 900
          },
          "interval": {
            "type": "integer",
            "example": 5
          }
        }
      },
      "Client": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "redirectUris": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowedScopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "persistent": {
            "type": "boolean"
          }
        }
      },
      "ClientWithSecret": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Client"
          },
          {
            "type": "object",
            "properties": {
              "secret": {
                "type": "string",
                "description": "Client secret — only returned on creation or secret regeneration"
              }
            }
          }
        ]
      },
      "ClientCreateRequest": {
        "type": "object",
        "required": [
          "name",
          "redirectUris",
          "allowedScopes"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "redirectUris": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "allowedScopes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "profile",
              "email",
              "openid"
            ]
          },
          "persistent": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "ClientUpdateRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "redirectUris": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowedScopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "persistent": {
            "type": "boolean"
          }
        }
      },
      "DiscoveryDocument": {
        "type": "object",
        "properties": {
          "issuer": {
            "type": "string"
          },
          "authorization_endpoint": {
            "type": "string"
          },
          "token_endpoint": {
            "type": "string"
          },
          "userinfo_endpoint": {
            "type": "string"
          },
          "jwks_uri": {
            "type": "string"
          },
          "token_introspection_endpoint": {
            "type": "string"
          },
          "token_revocation_endpoint": {
            "type": "string"
          },
          "scopes_supported": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "response_types_supported": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "grant_types_supported": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "id_token_signing_alg_values_supported": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Jwk": {
        "type": "object",
        "properties": {
          "kty": {
            "type": "string"
          },
          "use": {
            "type": "string"
          },
          "alg": {
            "type": "string"
          },
          "kid": {
            "type": "string"
          },
          "n": {
            "type": "string"
          },
          "e": {
            "type": "string"
          }
        }
      },
      "OAuthError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "error_description": {
            "type": "string"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}