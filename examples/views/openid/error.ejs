<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error — Easypanel Auth</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="admin-body" style="max-width:480px; padding-top:4rem;">
    <div class="card" style="text-align:center;">
        <h2 style="color:#e53e3e; margin-bottom:0.75rem;">Something went wrong</h2>
        <p style="font-weight:600; margin-bottom:0.25rem;"><%= error %></p>
        <% if (error_description) { %><p class="text-sm text-2"><%= error_description %></p><% } %>
        <div style="margin-top:1.5rem;"><a href="/" class="btn btn-primary">Go back</a></div>
    </div>
</div>
</body>
</html>
