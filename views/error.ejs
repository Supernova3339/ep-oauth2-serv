<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error — Easypanel Auth</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/theme.js"></script>
</head>
<body class="page-center">
<button class="theme-toggle" id="themeToggle" onclick="toggleTheme()" aria-label="Toggle theme">🌙</button>

<div class="card" style="max-width:480px; text-align:center;">
    <div class="error-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <circle cx="12" cy="12" r="10"/>
            <line x1="15" y1="9" x2="9" y2="15"/>
            <line x1="9" y1="9" x2="15" y2="15"/>
        </svg>
    </div>

    <h1 style="margin-bottom:1rem;">Something went wrong</h1>

    <div class="alert alert-error" style="text-align:left;">
        <strong><%= error %></strong>
        <% if (error_description) { %><br><span style="opacity:0.9;"><%= error_description %></span><% } %>
    </div>

    <div class="actions" style="justify-content:center; margin-top:1.5rem;">
        <button onclick="window.history.back()" class="btn btn-outline">Go back</button>
        <a href="/admin/clients" class="btn btn-primary">Dashboard</a>
    </div>
</div>
</body>
</html>
